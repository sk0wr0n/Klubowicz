# ---------------------------------------------------------------
# KLUBOWICZ – zmienne środowiskowe (OPCJONALNE)
#
# Na hostingu OVH konfigurację wpisujesz w pliku config.js
# (bez ponownego budowania aplikacji) – patrz docs/DEPLOY_OVH_SUPABASE.md.
#
# Jeśli wolisz wbudować klucze na etapie `npm run build`, skopiuj ten plik
# jako .env.local i uzupełnij. Wartości z config.js mają pierwszeństwo,
# o ile nie są przykładowymi ("TWOJ-...").
#
# Oba klucze są PUBLICZNE z założenia (bezpieczeństwo zapewnia RLS).
# NIGDY nie wpisuj tu klucza secret (sb_secret_...) ani service_role.
# ---------------------------------------------------------------

# Supabase -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://twojprojekt.supabase.co

# Supabase -> Project Settings -> API Keys -> Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# (starsze projekty) zamiast powyższego: klucz "anon public"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
